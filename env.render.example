# Render application settings
NODE_ENV=production
AUTH_MODE=oidc
VITE_APP_ID=our-orbit
VITE_AUTH_MODE=oidc
VITE_APP_TITLE=Our Orbit

# Aiven for MySQL: paste the TLS service URI from Aiven
DATABASE_URL=mysql://avnadmin:REPLACE_ME@REPLACE_ME.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED
# Optional CA PEM, with newlines encoded as \\n; recommended when Aiven provides one.
AIVEN_MYSQL_CA=

# Render session signing secret: use a long random value
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# OIDC provider: register the callback URL before using these values
OIDC_ISSUER_URL=https://YOUR-OIDC-ISSUER
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
OIDC_REDIRECT_URI=https://YOUR-RENDER-DOMAIN.onrender.com/api/oauth/callback
OIDC_SCOPES=openid profile email

# Cloudinary server-only credentials
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Google Maps browser key; restrict it by HTTP referrer to the Render domain
VITE_GOOGLE_MAPS_API_KEY=REPLACE_ME
